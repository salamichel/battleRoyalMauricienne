# Backend Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Frontend Configuration
REACT_APP_BACKEND_URL=http://localhost:3001

# Firebase Configuration (Optional - for persistence and leaderboard)
#
# To enable Firebase persistence:
# 1. Create a Firebase project at https://console.firebase.google.com
# 2. Create a Firestore database
# 3. Generate a service account key (Project Settings > Service Accounts > Generate new private key)
# 4. Copy the entire JSON content as a single line string (escape quotes if needed)
# 5. Set the FIREBASE_SERVICE_ACCOUNT environment variable with the JSON
#
# Example (replace with your actual service account JSON):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}
#
# Note: If not configured, the game will use in-memory storage (data lost on restart)
